# Build only the branded web client. The runtime API remains the published
# LibreChat image, which keeps this local white-label layer small and quick to
# export instead of baking the full development dependency tree into it.
FROM node:24.16.0-alpine AS client-builder

RUN apk upgrade --no-cache
RUN apk add --no-cache jemalloc
RUN apk add --no-cache python3 py3-pip uv

ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

COPY --from=ghcr.io/astral-sh/uv:0.9.5-python3.12-alpine /usr/local/bin/uv /usr/local/bin/uvx /bin/
RUN uv --version

ARG NODE_MAX_OLD_SPACE_SIZE=6144
ARG NPM_CI_TIMEOUT_SECONDS=1500
ARG NPM_CI_ATTEMPTS=2

RUN mkdir -p /app && chown node:node /app
WORKDIR /app

USER node

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node api/package.json ./api/package.json
COPY --chown=node:node client/package.json ./client/package.json
COPY --chown=node:node packages/data-provider/package.json ./packages/data-provider/package.json
COPY --chown=node:node packages/data-schemas/package.json ./packages/data-schemas/package.json
COPY --chown=node:node packages/api/package.json ./packages/api/package.json

RUN \
    touch .env ; \
    mkdir -p /app/client/public/images /app/logs /app/uploads /app/skill /app/data ; \
    chmod 1777 /app/data ; \
    npm config set fetch-retry-maxtimeout 600000 ; \
    npm config set fetch-retries 5 ; \
    npm config set fetch-retry-mintimeout 15000 ; \
    attempt=1 ; \
    until timeout "$NPM_CI_TIMEOUT_SECONDS" npm ci --no-audit ; do \
        status=$? ; \
        if [ "$attempt" -ge "$NPM_CI_ATTEMPTS" ]; then \
            exit "$status" ; \
        fi ; \
        echo "npm ci --no-audit failed with exit code $status; retrying attempt $((attempt + 1))/$NPM_CI_ATTEMPTS" ; \
        attempt=$((attempt + 1)) ; \
        npm cache clean --force || true ; \
        sleep 10 ; \
    done

COPY --chown=node:node client ./client
COPY --chown=node:node packages/data-provider ./packages/data-provider
COPY --chown=node:node packages/data-schemas ./packages/data-schemas
COPY --chown=node:node packages/api ./packages/api
COPY --chown=node:node packages/client ./packages/client

RUN NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" npm run frontend
RUN cd client && npm run typecheck

FROM registry.librechat.ai/danny-avila/librechat-dev:latest AS runtime

# Use LibreOffice Writer only for high-fidelity DOCX previews. The API's
# preview pipeline converts the DOCX to PDF and renders the pages with pdf.js.
USER root
RUN apk add --no-cache libreoffice-writer

RUN rm -rf /app/client/dist
COPY --from=client-builder --chown=node:node /app/client/dist /app/client/dist
COPY --from=client-builder --chown=node:node /app/packages/api/dist /app/packages/api/dist
COPY --chown=node:node api/server/services/start/tools.js /app/api/server/services/start/tools.js
# Brand-09 always-on: force the client skills toggle server-side on both agent
# controllers (base vs runtime-tip diff here is 5 unrelated lines; re-check it
# after every upstream rebase or drop these lines if upstream covers it).
COPY --chown=node:node api/server/controllers/agents/openai.js /app/api/server/controllers/agents/openai.js
COPY --chown=node:node api/server/controllers/agents/responses.js /app/api/server/controllers/agents/responses.js

USER node
